# Base de données (SQLite en local — chemin relatif au dossier prisma/)
DATABASE_URL="file:./dev.db"

# Clé API Anthropic, requise pour l'extraction automatique des formulaires.
# Obtenez une clé sur https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Modèle utilisé pour l'extraction (optionnel, défaut : claude-sonnet-5)
ANTHROPIC_MODEL="claude-sonnet-5"
